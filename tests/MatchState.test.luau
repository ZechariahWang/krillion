local MatchState = require("../src/ReplicatedStorage/Shared/MatchState")

return function(test)
	test("players start alive at the start height", function()
		local state = MatchState.new(6)
		MatchState.addPlayer(state, 1)
		MatchState.addPlayer(state, 2)
		assert(MatchState.aliveCount(state) == 2)
		assert(state.heights[1] == 6)
		assert(not MatchState.isOver(state))
	end)

	test("lift raises the platform and adds points", function()
		local state = MatchState.new(6)
		MatchState.addPlayer(state, 1)
		MatchState.applyLift(state, 1, 60, 6)
		assert(state.heights[1] == 12)
		assert(state.points[1] == 60)
	end)

	test("cull eliminates platforms under water and ends the match at one survivor", function()
		local state = MatchState.new(6)
		MatchState.addPlayer(state, 1)
		MatchState.addPlayer(state, 2)
		MatchState.applyLift(state, 1, 100, 10)
		MatchState.surge(state, 7)
		local culled = MatchState.cull(state)
		assert(#culled == 1 and culled[1] == 2)
		assert(MatchState.aliveCount(state) == 1)
		assert(MatchState.isOver(state))
		assert(MatchState.winner(state) == 1)
	end)

	test("same-cull tiebreak picks the highest platform, then most points", function()
		local state = MatchState.new(6)
		MatchState.addPlayer(state, 1)
		MatchState.addPlayer(state, 2)
		MatchState.applyLift(state, 1, 30, 3)
		MatchState.applyLift(state, 2, 10, 1)
		MatchState.surge(state, 50)
		MatchState.cull(state)
		assert(MatchState.aliveCount(state) == 0)
		assert(MatchState.winner(state) == 1)

		local tie = MatchState.new(6)
		MatchState.addPlayer(tie, 1)
		MatchState.addPlayer(tie, 2)
		MatchState.applyLift(tie, 1, 10, 1)
		MatchState.applyLift(tie, 2, 15, 1)
		MatchState.surge(tie, 50)
		MatchState.cull(tie)
		assert(MatchState.winner(tie) == 2)
	end)

	test("external elimination (fell in) and leaving both remove from alive", function()
		local state = MatchState.new(6)
		MatchState.addPlayer(state, 1)
		MatchState.addPlayer(state, 2)
		MatchState.addPlayer(state, 3)
		MatchState.eliminate(state, 1)
		MatchState.removePlayer(state, 2)
		assert(MatchState.aliveCount(state) == 1)
		assert(MatchState.winner(state) == 3)
	end)

	test("a revived player is alive again above the water and keeps their points", function()
		local state = MatchState.new(6)
		MatchState.addPlayer(state, 1)
		MatchState.applyLift(state, 1, 30, 3)
		MatchState.surge(state, 20)
		MatchState.cull(state)
		MatchState.eliminate(state, 1)
		MatchState.revive(state, 1, 4)
		assert(state.alive[1] == true)
		assert(state.heights[1] == state.waterY + 4)
		assert(state.points[1] == 30)
	end)

	test("a late joiner starts alive at the given height with no points", function()
		local state = MatchState.new(6)
		MatchState.addPlayer(state, 1)
		MatchState.applyLift(state, 1, 40, 4)
		MatchState.surge(state, 2)
		MatchState.addPlayerAt(state, 2, 10)
		assert(state.alive[2] == true)
		assert(state.heights[2] == 10)
		assert(state.points[2] == 0)
		assert(MatchState.aliveCount(state) == 2)
	end)

	test("lowestAlive skips sunk players and is nil with nobody alive", function()
		local state = MatchState.new(6)
		assert(MatchState.lowestAlive(state) == nil)
		MatchState.addPlayer(state, 1)
		MatchState.addPlayer(state, 2)
		MatchState.applyLift(state, 1, 30, 3)
		assert(MatchState.lowestAlive(state) == 6)
		MatchState.eliminate(state, 2)
		assert(MatchState.lowestAlive(state) == 9)
	end)

	test("a player who left the match cannot be revived", function()
		local state = MatchState.new(6)
		MatchState.addPlayer(state, 1)
		MatchState.removePlayer(state, 1)
		MatchState.revive(state, 1, 4)
		assert(state.alive[1] == nil)
	end)

	test("players the water poll takes during the surge count toward the winner", function()
		local state = MatchState.new(6)
		MatchState.addPlayer(state, 1)
		MatchState.addPlayer(state, 2)
		MatchState.applyLift(state, 1, 30, 3)
		MatchState.surge(state, 20)
		-- Both roots dropped under the rising water before the state cull ran.
		MatchState.eliminate(state, 2)
		MatchState.eliminate(state, 1)
		local culled = MatchState.cull(state)
		assert(#culled == 0)
		assert(MatchState.aliveCount(state) == 0)
		assert(MatchState.winner(state) == 1)
	end)

	test("a new surge forgets who sank in the last one", function()
		local state = MatchState.new(6)
		MatchState.addPlayer(state, 1)
		MatchState.addPlayer(state, 2)
		MatchState.addPlayer(state, 3)
		MatchState.applyLift(state, 1, 50, 5)
		MatchState.applyLift(state, 2, 50, 5)
		MatchState.surge(state, 7)
		MatchState.cull(state)
		assert(state.alive[3] == nil)
		MatchState.surge(state, 20)
		MatchState.cull(state)
		assert(MatchState.winner(state) ~= 3)
	end)

end
