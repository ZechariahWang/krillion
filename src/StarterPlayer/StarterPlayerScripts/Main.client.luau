--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Client = script.Parent:WaitForChild("Client")
local Fx = require(Client.Fx)
local Hud = require(Client.Hud)
local Status = require(Client.Status)
local Reveal = require(Client.Reveal)
local Lobby = require(Client.Lobby)
local LobbyQuiz = require(Client.LobbyQuiz)
local Results = require(Client.Results)

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
Fx.init(playerGui)
Hud.init(playerGui)
Status.init(playerGui)
Reveal.init(playerGui)
Lobby.init(playerGui)
LobbyQuiz.init(playerGui)
Results.init(playerGui)

Net.event("RoundState").OnClientEvent:Connect(function(payload)
	Hud.onState(payload)
	Status.onState(payload)
	Reveal.onState(payload)
	Lobby.onState(payload)
	Results.onState(payload)
end)
Net.event("AnswerResult").OnClientEvent:Connect(Hud.onAnswerResult)
Net.event("Reveal").OnClientEvent:Connect(Reveal.onReveal)
Net.event("Eliminated").OnClientEvent:Connect(Lobby.onEliminated)
Net.event("MatchEnded").OnClientEvent:Connect(Results.onMatchEnded)
Net.event("LobbyQuizPrompt").OnClientEvent:Connect(LobbyQuiz.onPrompt)
Net.event("LobbyQuizResult").OnClientEvent:Connect(LobbyQuiz.onResult)
Net.event("CoinsChanged").OnClientEvent:Connect(function(coins)
	Hud.setCoins(coins)
	LobbyQuiz.setCoins(coins)
end)
