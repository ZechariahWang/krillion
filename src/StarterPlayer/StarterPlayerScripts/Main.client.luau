--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Client = script.Parent:WaitForChild("Client")
local Ui = require(Client.Ui)
local Fx = require(Client.Fx)
local Toasts = require(Client.Toasts)
local Wallet = require(Client.Wallet)
local Hud = require(Client.Hud)
local Status = require(Client.Status)
local Tide = require(Client.Tide)
local WaterFx = require(Client.WaterFx)
local Reveal = require(Client.Reveal)
local Lobby = require(Client.Lobby)
local LobbyQuiz = require(Client.LobbyQuiz)
local Results = require(Client.Results)
local ShopUi = require(Client.ShopUi)
local RevivePrompt = require(Client.RevivePrompt)
local Rail = require(Client.Rail)
local Quests = require(Client.Quests)
local Rewards = require(Client.Rewards)
local Tutorial = require(Client.Tutorial)
local Standings = require(Client.Standings)
local AnimationReset = require(Client.AnimationReset)

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
-- Live outlines, captions, pop-up fit and icons on the Studio GUIs and world text; it never yields.
Ui.bindAll(playerGui)
-- Controllers added for the Sink or Niche port wait at most 10 s for their GUI and then do nothing,
-- so one missing ScreenGui never stops the others.
Fx.init(playerGui)
Toasts.init(playerGui)
Wallet.init(playerGui)
Hud.init(playerGui)
Status.init(playerGui)
Tide.init(playerGui)
WaterFx.init()
Reveal.init(playerGui)
Lobby.init(playerGui)
LobbyQuiz.init(playerGui)
Results.init(playerGui)
RevivePrompt.init(playerGui)
Rail.init(playerGui)
ShopUi.init(playerGui)
Quests.init(playerGui)
Rewards.init(playerGui)
Tutorial.init(playerGui)
Standings.init(playerGui)
AnimationReset.init()

Net.event("RoundState").OnClientEvent:Connect(function(payload)
	Hud.onState(payload)
	Status.onState(payload)
	Tide.onState(payload)
	WaterFx.onState(payload)
	Reveal.onState(payload)
	Lobby.onState(payload)
	Results.onState(payload)
	ShopUi.onState(payload)
	Rail.onState(payload)
	Wallet.onState(payload)
	Quests.onState(payload)
	Rewards.onState(payload)
	Standings.onState(payload)
end)
Net.event("AnswerResult").OnClientEvent:Connect(Hud.onAnswerResult)
Net.event("Reveal").OnClientEvent:Connect(function(payload)
	Reveal.onReveal(payload)
	Standings.onReveal(payload)
	Tide.onReveal(payload)
end)
Net.event("Eliminated").OnClientEvent:Connect(Lobby.onEliminated)
Net.event("MatchEnded").OnClientEvent:Connect(Results.onMatchEnded)
Net.event("LobbyQuizPrompt").OnClientEvent:Connect(LobbyQuiz.onPrompt)
Net.event("LobbyQuizResult").OnClientEvent:Connect(LobbyQuiz.onResult)
Net.event("ProfileChanged").OnClientEvent:Connect(function(profile)
	Hud.setCash(profile.cash)
	Hud.onProfile(profile)
	LobbyQuiz.setCash(profile.cash)
	ShopUi.onProfile(profile)
	Wallet.onProfile(profile)
	Quests.onProfile(profile)
	Rewards.onProfile(profile)
	Tutorial.onProfile(profile)
end)
Net.event("RevivePrompt").OnClientEvent:Connect(RevivePrompt.onPrompt)
Net.event("Notify").OnClientEvent:Connect(Toasts.onNotify)
Net.event("ShellsEarned").OnClientEvent:Connect(Wallet.onShells)
Net.event("BoostResult").OnClientEvent:Connect(Hud.onBoostResult)
-- Lobby.onJoinResult arrives with late join (W6); until then the result is shown as a toast.
Net.event("JoinResult").OnClientEvent:Connect(function(payload)
	local handler = (Lobby :: any).onJoinResult
	if handler ~= nil then
		handler(payload)
	else
		Toasts.show(payload.message, if payload.status == "joined" then "good" else "info")
	end
end)
